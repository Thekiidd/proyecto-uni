MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueTitle: "Pr\xF3logo: El Bosque del Eco"
  lines:
  - speakerName: Falin (Border Collie)
    speakerPortrait: {fileID: 21300000, guid: 223a1abc81835b67aa1df484313d7a04, type: 3}
    text: "\xA1Qu\xE9 ma\xF1ana tan incre\xEDble para correr junto al bosque! \xA1Miren
      qu\xE9 lejos rod\xF3 la pelota, yo llegar\xE9 primero!"
    typingSpeed: 0.025
  - speakerName: "M\xEDa (Schnauzer)"
    speakerPortrait: {fileID: 21300000, guid: 306dcb95fb465a89abe027912a8720e0, type: 3}
    text: "\xA1Por aqu\xED, Falin! Mi olfato detecta el rastro entre ese c\xEDrculo
      de hongos brillantes junto al tronco antiguo."
    typingSpeed: 0.025
  - speakerName: Kiara (Schnauzer)
    speakerPortrait: {fileID: 21300000, guid: 6d8c0356ef74560bb903b85a65849b21, type: 3}
    text: "\xA1Esperen, hermanas! \xA1No se alejen tanto, ese claro desprende una
      luz m\xE1gica muy extra\xF1a!"
    typingSpeed: 0.025
  - speakerName: Narrador
    speakerPortrait: {fileID: 0}
    text: "Al cruzar el c\xEDrculo m\xEDstico, despertaron en el Bosque del Eco.
      Las ra\xEDces del Zarzal Sombr\xEDo emergieron, y Kiara empuj\xF3 a sus hermanas
      para salvarlas, quedando atrapada en la cumbre."
    typingSpeed: 0.025
  - speakerName: Hada Maya
    speakerPortrait: {fileID: 21300000, guid: 7e914613cf725c57afae132091521ec9, type: 3}
    text: "Bienvenidas al Bosque del Eco. Para liberar a su hermana Kiara y restaurar
      el C\xEDrculo R\xFAnico, deber\xE1n ascender por el Sendero de las Ra\xEDces."
    typingSpeed: 0.025
  - speakerName: "Falin y M\xEDa"
    speakerPortrait: {fileID: 21300000, guid: 2935ae5505d35b60ac315462f69125c6, type: 3}
    text: "\xA1Resiste, Kiara! \xA1Ninguna monta\xF1a detendr\xE1 a tres hermanas
      unidas!"
    typingSpeed: 0.025
  nextSceneOnComplete: Hub
