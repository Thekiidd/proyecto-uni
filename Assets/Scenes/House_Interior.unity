--- !u!114 &874306242
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 874306241}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6ad2a166e6ed7f4085b10a2957ed893, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Platformer.TopDown.VillageNPC
  dialogueData: {fileID: 0}
  npcDisplayName: "Due\xF1o de Casa"
  inlineDialogueLines:
  - "\xA1Ah, un visitante! Esta es mi casa. Hace fr\xEDo afuera, \xBFverdad?"
  - "Llevo aqu\xED toda mi vida. Esta aldea es el mejor lugar del mundo, aunque ahora
    est\xE1 oscura sin los cristales."
  - "\xBFVes ese cristal roto en el estante? Era de mi abuela. Lloramos cuando dej\xF3
    de brillar."
  - "Si necesitas descansar, eres bienvenido. Los viajeros siempre tienen un rinc\xF3n
    aqu\xED."
  patrolDistance: 0.5
  moveSpeed: 0.6
  waitTime: 1.5
  interactRadius: 1.6
