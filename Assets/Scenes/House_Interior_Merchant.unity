  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6ad2a166e6ed7f4085b10a2957ed893, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Platformer.TopDown.VillageNPC
  dialogueData: {fileID: 0}
  npcDisplayName: Asistente del Mercader
  inlineDialogueLines:
  - "\xA1El jefe no est\xE1 ahora mismo! \xBFEn qu\xE9 puedo ayudarte?"
  - Tenemos los mejores mapas del reino. Actualizados cada semana.
  - Si buscas el cristal... el jefe dice que no sabe nada. Pero yo vi algo brillante
    en esa caja.
  - "Los precios son fijos. Bueno... todo es negociable si traes informaci\xF3n valiosa."
  patrolDistance: 0.5
  moveSpeed: 0.6
  waitTime: 1.5
  interactRadius: 1.6
