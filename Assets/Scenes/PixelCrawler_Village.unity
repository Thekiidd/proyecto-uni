  dialogueData: {fileID: 0}
  npcDisplayName: Pozo del Pueblo
  inlineDialogueLines:
  - "Un viejo pozo de piedra. El agua est\xE1 fresca y cristalina."
  - "Cuentan que en el fondo hay una moneda por cada deseo pedido en los \xFAltimos
    100 a\xF1os."
  - "El agua del pozo brilla ligeramente por las noches. Nadie sabe por qu\xE9."
  patrolDistance: 0
  moveSpeed: 0.8
  waitTime: 1.5
  interactRadius: 1.6
