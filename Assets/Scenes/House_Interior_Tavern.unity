  m_Script: {fileID: 11500000, guid: b6ad2a166e6ed7f4085b10a2957ed893, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Platformer.TopDown.VillageNPC
  dialogueData: {fileID: 0}
  npcDisplayName: "Tabl\xF3n_Avisos"
  inlineDialogueLines:
  - "TABL\xD3N DE MISIONES:\n\u2022 Se busca: al ladr\xF3n de los cristales.\n\u2022
    Recompensa: 500 monedas de oro.\n\u2022 Contactar: Sabio Eldor."
  - 'AVISO: La taberna cierra a medianoche. Los que queden dormidos amanecen barriendo.'
  - "OFERTA: Habitaci\xF3n + desayuno = 5 monedas. Solo si no traes mascotas... a
    menos que sea un perro heroico."
  patrolDistance: 0
  moveSpeed: 0.8
  waitTime: 1.5
  interactRadius: 1.2
