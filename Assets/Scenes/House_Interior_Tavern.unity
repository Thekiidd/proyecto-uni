  m_Script: {fileID: 11500000, guid: b6ad2a166e6ed7f4085b10a2957ed893, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Platformer.TopDown.VillageNPC
  dialogueData: {fileID: 0}
  npcDisplayName: Tabernera Elena
  inlineDialogueLines:
  - "\xA1Bienvenido a 'La Linterna Dorada'! \xBFTe sirvo algo?"
  - Tenemos cerveza de cebada, vino del norte y... agua, si prefieres.
  - "\xBFBuscas informaci\xF3n? Aqu\xED pasan todos los viajeros del reino. He escuchado
    muchas cosas."
  - "El viajero de anoche dej\xF3 este mapa en la barra. Quiz\xE1 te sea \xFAtil..."
  patrolDistance: 2
  moveSpeed: 0.6
  waitTime: 1.5
  interactRadius: 1.6
