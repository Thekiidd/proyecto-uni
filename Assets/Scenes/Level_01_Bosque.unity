  m_Script: {fileID: 11500000, guid: b2564b3a10335b74aa5d2102707890ea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Kimaya.MayaDialogue
  lines:
  - "\xA1Lo lograron! Las dos juntas rompieron el hechizo del Zarzal Sombr\xEDo."
  - "Kiara est\xE1 ah\xED, en la plataforma. Subamos a rescatarla."
  - "El c\xEDrculo de hadas vuelve a brillar... pero no del todo."
  - "El camino de regreso a casa a\xFAn no est\xE1 abierto. Pero eso es para otro
    d\xEDa."
  - "Por ahora, \xA1las tres hermanas est\xE1n juntas de nuevo!"
  speakerName: Maya
  mayaPortrait: {fileID: 0}
  nameColor: {r: 0.7, g: 0.4, b: 1, a: 1}
  typeSpeed: 0.03
  activateOnTrigger: 1
  onlyOnce: 1
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
