  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 298e4dc011b100c49a2d027a51ffcfb2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Platformer.Dialogue.NPCInteractable
  dialogue:
    npcName: Sabio Eldor
    avatar: {fileID: 0}
    lines:
    - "\xA1Ah, fiel guardi\xE1n canino! Me alegra tanto que hayas venido."
    - "Una extra\xF1a sombra azot\xF3 el reino anoche. Los Cristales de Luz fueron
      robados y dispersados a trav\xE9s del bosque."
    - "Los aldeanos est\xE1n asustados, pero yo s\xE9 que tu valent\xEDa y rapidez
      pueden salvarnos."
    - Toma estos 5 diamantes que recolectamos para ayudarte en tu camino.
    - "\xA1Sube por las escaleras de piedra de la plaza o sigue el camino al port\xF3n
      del oeste para salir a la aventura!"
    rewardCoins: 5
    rewardMessage: 
  interactRadius: 2.2
