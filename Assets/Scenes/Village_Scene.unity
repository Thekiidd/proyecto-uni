  dialogue:
    npcName: "Granjero Tom\xE1s"
    avatar: {fileID: 0}
    lines:
    - "\xA1Hola amiguito! Cuidando la cosecha de trigo como todos los d\xEDas."
    - "Si caes al vac\xEDo en los bosques o monta\xF1as, mant\xE9n la calma y calcula
      bien el impulso de tus patitas."
    - "\xA1Todo el pueblo cree en ti, noble guardi\xE1n!"
    rewardCoins: 0
    rewardMessage: 
  interactRadius: 2.2
