  m_Script: {fileID: 11500000, guid: 298e4dc011b100c49a2d027a51ffcfb2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Platformer.Dialogue.NPCInteractable
  dialogue:
    npcName: Lili
    avatar: {fileID: 0}
    lines:
    - "\xA1Hola perrito lindo! *te acaricia suavemente las orejitas*"
    - "\xA1Eres tan suave y veloz! Mi abuelo me cont\xF3 que puedes saltar sobre
      cualquier obst\xE1culo."
    - "Ten mucho cuidado en el bosque. Hay slimes verdes, pero si saltas encima de
      ellos los vencer\xE1s."
    - "\xA1Estar\xE9 esper\xE1ndote aqu\xED en el jard\xEDn con las flores para darte
      m\xE1s caricias y premios cuando regreses!"
    rewardCoins: 0
    rewardMessage: 
  interactRadius: 2.2
